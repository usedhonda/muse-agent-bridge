# Local state and machine-specific configuration: never commit.
# (Project rule: connection details, credentials, and local state live in
# .local/ or in Muse's secure connection — not in this repository.)
.local/

# Secrets and local config, wherever they appear
.env
.env.*
*.local.json
config.local.json

# Runtime state and logs
state/
*.log

# Tooling noise
.venv/
__pycache__/
node_modules/
.DS_Store

# bridge state never lives in the repo (adapter default path guard)
state.json
state.json.good
state.json.lock
