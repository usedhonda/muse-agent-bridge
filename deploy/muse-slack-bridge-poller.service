# systemd service for the polling intake on Muse's agent VM.
# Template only: installation/ownership must be configured through the host's
# approved lifecycle mechanism. This repository contains no watchdog installer.
# Paths below are examples; adapt them and verify the supported service manager.
# Polling needs the runtime-specific dynamic_credentials adapter and authorized
# surrogate-aware egress. It excludes configured agentChannels (Socket-only).
# See docs/runtime-lifecycle.md; this file does not prove restart persistence.
[Unit]
Description=muse-slack-bridge polling intake (owner DM)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/hatch/muse-slack-bridge
ExecStart=/home/hatch/muse-slack-bridge/.venv/bin/python -m bridge.poller --config /home/hatch/muse-slack-bridge/.local/config.yaml --state /home/hatch/muse-slack-bridge/.local/state --interval 20
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
